# Qwen3-4B-Instruct-2507 (dense, non-thinking update of Qwen3-4B), official bf16 checkpoint: the
# newest Qwen dense 4B instruct model, in the speed/quality study (reports/speed_quality/).
# The template has no thinking switch and injects nothing. Text-only checkpoint (no
# --language-model-only); --max-num-batched-tokens=1024 and --max-num-seqs=16 as in the other
# presets; --generation-config=vllm ignores the upload's sampling defaults; 0.90 of the GPU.
JEVEMU_VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
JEVEMU_VLLM_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
JEVEMU_VLLM_DTYPE=auto
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS=
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
