# Qwen3-14B (dense, hybrid thinking), official AWQ INT4 (AutoAWQ GEMM, group 128, zero point;
# AWQ-Marlin). Thinking off for every chat and /tokenize render; fp16 activations as declared.
# Measured on an RTX 3090 (docs/research/candidates.md): 9.44 GiB weights, 10.11 GiB KV cache
# (66,224 tokens), ~75 s to healthy.
# Text-only checkpoint (no --language-model-only); --max-num-batched-tokens=1024 and
# --max-num-seqs=16 as in the Qwen3.5-architecture presets; --generation-config=vllm ignores the
# upload's sampling defaults.
JEVEMU_VLLM_MODEL=Qwen/Qwen3-14B-AWQ
JEVEMU_VLLM_MODEL_REVISION=31c69efc29464b6bb0aee1398b5a7b50a99340c3
JEVEMU_VLLM_DTYPE=auto
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
