# Qwen/Qwen3-0.6B bf16: the fast default for tests and smoke runs (~1.5 GiB weights).
# Same launch as docker/vllm/compose.yaml's defaults, with the revision pinned and thinking off, as in
# every Qwen3 preset (the adapter renders the generation prompt: `<think>\n\n</think>\n\n` before
# the prefill).
JEVEMU_VLLM_MODEL=Qwen/Qwen3-0.6B
JEVEMU_VLLM_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.85
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS=
