# Qwen3-4B (dense, hybrid thinking; the April 2025 release), official bf16 checkpoint, already in
# the shared cache from the 20-item smoke run: the predecessor of Qwen3-4B-Instruct-2507 in the
# speed/quality study (reports/speed_quality/). Thinking off for every chat and /tokenize render.
# Text-only checkpoint (no --language-model-only); --max-num-batched-tokens=1024 and
# --max-num-seqs=16 as in the other presets; --generation-config=vllm ignores the upload's sampling
# defaults; 0.90 of the GPU.
JEVEMU_VLLM_MODEL=Qwen/Qwen3-4B
JEVEMU_VLLM_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
JEVEMU_VLLM_DTYPE=auto
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
