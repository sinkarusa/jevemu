# SmolLM3-3B (HuggingFaceTB/SmolLM3-3B: 3B dense, hybrid thinking; Apache-2.0), official bf16
# checkpoint: the Hugging Face point of the speed/quality study (reports/speed_quality/). vLLM 0.30.0
# serves SmolLM3ForCausalLM through its Transformers backend. Thinking off for every chat and
# /tokenize render: the template then writes "Reasoning Mode: /no_think" and an empty think block
# before the prefill. The template always injects a system turn (knowledge cutoff, today's date and
# "You are a helpful AI assistant named SmolLM, trained by Hugging Face."), so the rendered prompt
# carries the day's date. --max-num-batched-tokens=1024 and --max-num-seqs=16 as in the other
# presets; --generation-config=vllm ignores the upload's sampling defaults; 0.90 of the GPU.
JEVEMU_VLLM_MODEL=HuggingFaceTB/SmolLM3-3B
JEVEMU_VLLM_MODEL_REVISION=a07cc9a04f16550a088caea529712d1d335b0ac1
JEVEMU_VLLM_DTYPE=bfloat16
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
