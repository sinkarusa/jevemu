# Phi-4-mini-instruct (3.8B dense, 200k vocabulary; MIT), official bf16 checkpoint: the newest Phi
# mini instruct model, in the speed/quality study (reports/speed_quality/). No thinking mode; the
# template injects no system turn and renders the prefill as `<|assistant|>Answer:`.
# Text-only checkpoint; --max-num-batched-tokens=1024 and --max-num-seqs=16 as in the other
# presets; --generation-config=vllm ignores the upload's sampling defaults; 0.90 of the GPU.
JEVEMU_VLLM_MODEL=microsoft/Phi-4-mini-instruct
JEVEMU_VLLM_MODEL_REVISION=cfbefacb99257ffa30c83adab238a50856ac3083
JEVEMU_VLLM_DTYPE=auto
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS=
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
