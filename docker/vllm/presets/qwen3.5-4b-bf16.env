# Qwen3.5-4B (dense, Qwen3.5 hybrid DeltaNet/attention architecture, thinks by default), official
# bf16 checkpoint: the 4B rung of the speed/quality study (reports/speed_quality/).
# Launch as qwen3.5-9b-bf16: thinking off for every chat and /tokenize render;
# --language-model-only skips the vision tower; --max-num-batched-tokens=1024 bounds echo's
# prompt-logprob spike (248k vocabulary); --generation-config=vllm ignores the upload's sampling
# defaults; 0.90 of the GPU.
JEVEMU_VLLM_MODEL=Qwen/Qwen3.5-4B
JEVEMU_VLLM_MODEL_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
JEVEMU_VLLM_DTYPE=bfloat16
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--language-model-only --max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
