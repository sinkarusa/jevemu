# Qwen3-32B (dense, hybrid thinking), official AWQ INT4 (AutoAWQ GEMM, group 128, zero point;
# AWQ-Marlin). Thinking off for every chat and /tokenize render. The config declares float16 (the
# AutoAWQ export dtype), so --dtype=auto serves fp16 activations.
# Measured on an RTX 3090 (docs/research/candidates.md): 18.24 GiB weights, 2.43 GiB KV cache
# (9,936 tokens), ~90 s to healthy.
# Text-only checkpoint (no --language-model-only); --max-num-batched-tokens=1024 and
# --max-num-seqs=16 as in the Qwen3.5-architecture presets; --generation-config=vllm ignores the
# upload's sampling defaults.
JEVEMU_VLLM_MODEL=Qwen/Qwen3-32B-AWQ
JEVEMU_VLLM_MODEL_REVISION=0499c3ac83fdef8810b907a23894ba91e95eddd8
JEVEMU_VLLM_DTYPE=auto
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.95
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
