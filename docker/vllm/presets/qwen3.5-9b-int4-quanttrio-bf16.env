# Qwen3.5-9B, QuantTrio AWQ INT4 served with bf16 activations: the checkpoint declares float16,
# so qwen3.5-9b-int4-quanttrio runs in fp16; this preset isolates the 4-bit weights from the
# activation dtype (JEVEMU_VLLM_DTYPE set here overrides the environment like every preset value).
# Measured on an RTX 3090 (docs/research/quantization_report.md):
# 10.35 GiB weights, 8.72 GiB KV cache (201,076 tokens), ~105 s to healthy.
# The qwen3.5-9b-* presets form the quantization ladder and share every flag; only the checkpoint
# (and, for -int4-quanttrio-bf16, the dtype) differs:
# - 0.90 of the GPU; thinking off for every chat and /tokenize render (the template thinks by
#   default); --language-model-only skips the vision tower.
# - --max-num-batched-tokens=1024 bounds echo's prompt-logprob spike (full 248k-vocab logits per
#   prompt token of a chunk, not covered by vLLM's startup memory profile).
# - --generation-config=vllm ignores each checkpoint's generation_config.json sampling defaults
#   (they differ between uploads; QuantTrio's sets presence_penalty=1.5).
JEVEMU_VLLM_MODEL=QuantTrio/Qwen3.5-9B-AWQ
JEVEMU_VLLM_MODEL_REVISION=938f8e3ef86c9d1e9bec3705e149694c172592f1
JEVEMU_VLLM_DTYPE=bfloat16
JEVEMU_VLLM_MAX_MODEL_LEN=8192
JEVEMU_VLLM_GPU_MEMORY_UTILIZATION=0.90
JEVEMU_VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
JEVEMU_VLLM_EXTRA_ARGS='--language-model-only --max-num-seqs=16 --max-num-batched-tokens=1024 --generation-config=vllm'
